# Google OAuth (Gmail send only) — set these in Vercel Project Settings → Environment Variables
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match an Authorized redirect URI in Google Cloud Console
# Example production:
# GMAIL_REDIRECT_URI=https://dashboard-sales-sand.vercel.app/api/gmail/callback
GMAIL_REDIRECT_URI=https://dashboard-sales-sand.vercel.app/api/gmail/callback

# Public app URL (no trailing slash)
APP_URL=https://dashboard-sales-sand.vercel.app

# Random secret used to encrypt Gmail tokens in HttpOnly cookies (min 32 chars)
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars
